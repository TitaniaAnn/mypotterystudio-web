# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_secure_password

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
ALLOWED_GITHUB_USERS=username

# Website Configuration
SITE_URL=https://mypotterystudio.com

# Beta Testers Configuration
BETA_DOWNLOAD_ANDROID=https://play.google.com/apps/internaltest/...
BETA_DOWNLOAD_IOS=https://testflight.apple.com/join/...
BETA_GITHUB_REPO=https://github.com/user/repo.git
BETA_GITHUB_TOKEN=github_pat_...

# Email Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=noreply@mypotterystudio.com
MAIL_FROM_NAME="My Pottery Studio"
